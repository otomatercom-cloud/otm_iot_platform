<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iot_device_type_list" model="ir.ui.view">
        <field name="name">otm.iot.device.type.list</field>
        <field name="model">otm.iot.device.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="protocol"/>
                <field name="channel_count"/>
            </list>
        </field>
    </record>

    <record id="view_iot_device_type_form" model="ir.ui.view">
        <field name="name">otm.iot.device.type.form</field>
        <field name="model">otm.iot.device.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="protocol"/>
                        <field name="channel_count"/>
                        <field name="icon"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iot_device_type" model="ir.actions.act_window">
        <field name="name">Device Types</field>
        <field name="res_model">otm.iot.device.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

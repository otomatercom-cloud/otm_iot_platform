<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_otm_iot" model="ir.module.category">
        <field name="name">Otomater IoT Platform</field>
    </record>

    <!-- Odoo 19: res.groups no longer sets category_id directly - it goes through
         res.groups.privilege (privilege.category_id -> ir.module.category,
         group.privilege_id -> privilege). One privilege record shared by this module's groups. -->
    <record id="privilege_otm_iot" model="res.groups.privilege">
        <field name="name">Otomater IoT Platform</field>
        <field name="category_id" ref="module_category_otm_iot"/>
    </record>

    <record id="group_iot_manager" model="res.groups">
        <field name="name">IoT Manager</field>
        <field name="privilege_id" ref="privilege_otm_iot"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_iot_customer_portal" model="res.groups">
        <field name="name">IoT Customer (Portal)</field>
        <field name="privilege_id" ref="privilege_otm_iot"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <!-- Managers see everything -->
    <record id="rule_iot_device_manager" model="ir.rule">
        <field name="name">IoT Device: Manager sees all</field>
        <field name="model_id" ref="model_otm_iot_device"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_iot_manager'))]"/>
    </record>

    <!-- Portal customers only see their own devices -->
    <record id="rule_iot_device_portal" model="ir.rule">
        <field name="name">IoT Device: Portal sees own only</field>
        <field name="model_id" ref="model_otm_iot_device"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_iot_customer_portal'))]"/>
    </record>
</odoo>
